<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advance_kitchen.KitchenBoard">
        <t t-call="advance_kitchen.KitchenColumn">
            <t t-set="title" t-value="'New'"/>
            <t t-set="state" t-value="'pending'"/>
            <t t-set="orders" t-value="grouped.new"/>
            <t t-set="total" t-value="(grouped.new &amp;&amp; grouped.new.length) || 0"/>
            <t t-set="hiddenCount" t-value="0"/>
        </t>
        <t t-call="advance_kitchen.KitchenColumn">
            <t t-set="title" t-value="'Preparing'"/>
            <t t-set="state" t-value="'in_progress'"/>
            <t t-set="orders" t-value="grouped.preparing"/>
            <t t-set="total" t-value="(grouped.preparing &amp;&amp; grouped.preparing.length) || 0"/>
            <t t-set="hiddenCount" t-value="0"/>
        </t>
        <t t-call="advance_kitchen.KitchenColumn">
            <t t-set="title" t-value="'Ready'"/>
            <t t-set="state" t-value="'ready'"/>
            <t t-set="orders" t-value="grouped.ready"/>
            <t t-set="total" t-value="(grouped.ready &amp;&amp; grouped.ready.length) || 0"/>
            <t t-set="hiddenCount" t-value="0"/>
        </t>
        <t t-call="advance_kitchen.KitchenColumn">
            <t t-set="title" t-value="'Completed'"/>
            <t t-set="state" t-value="'done'"/>
            <t t-set="orders" t-value="grouped.completed"/>
            <t t-set="total" t-value="completedTotal"/>
            <t t-set="hiddenCount" t-value="completedHiddenCount"/>
        </t>
    </t>

    <t t-name="advance_kitchen.KitchenColumn">
        <div t-attf-class="akd-col akd-col-{{ state }}" t-att-data-col-state="state">
            <div class="akd-col-header">
                <div class="akd-col-title">
                    <span class="akd-col-indicator"/>
                    <t t-esc="title"/>
                </div>
                <div class="akd-col-count"><t t-esc="total"/></div>
            </div>
            <div class="akd-col-body">
                <t t-if="orders &amp;&amp; orders.length">
                    <t t-foreach="orders" t-as="order" t-key="order.id">
                        <t t-if="state === 'done'">
                            <t t-call="advance_kitchen.KitchenCompletedOrderRow"/>
                        </t>
                        <t t-else="">
                            <t t-call="advance_kitchen.KitchenOrderCard"/>
                        </t>
                    </t>
                    <t t-if="state === 'done' &amp;&amp; hiddenCount">
                        <button type="button" class="akd-view-all-btn akd-view-all-btn--column">
                            View <t t-esc="hiddenCount"/> more
                        </button>
                    </t>
                </t>
                <t t-else="">
                    <div class="akd-col-empty">No orders</div>
                </t>
            </div>
        </div>
    </t>

    <t t-name="advance_kitchen.KitchenEmptyState">
        <div class="kitchen-empty">
            <div class="kitchen-empty-icon">&#x1F373;</div>
            <div class="kitchen-empty-text">No orders in queue</div>
        </div>
    </t>

    <t t-name="advance_kitchen.KitchenCompletedOrderRow">
        <div class="akd-completed-order-row" t-att-data-order-id="order.id">
            <div class="akd-completed-order-main">
                <div class="akd-completed-order-name">
                    <t t-esc="order.order_name || ''"/>
                </div>
                <div class="akd-completed-order-meta">
                    <span><t t-esc="order.table_name || 'No Table'"/></span>
                    <span><t t-esc="order.customer_name || 'Guest'"/></span>
                    <span><t t-esc="(order.lines &amp;&amp; order.lines.length) || 0"/> item(s)</span>
                </div>
            </div>
            <div class="akd-completed-order-side">
                <span class="akd-completed-order-time"><t t-esc="formatTime(order.order_date)"/></span>
                <span class="akd-completed-order-check"><i class="fa fa-check"/></span>
            </div>
        </div>
    </t>

    <t t-name="advance_kitchen.KitchenOrderCard">
        <div class="akd-card" t-att-data-order-id="order.id" t-att-data-order-state="order.order_state || 'pending'">
            <div class="akd-card-top-bar"/>
            <div class="akd-card-header">
                <div>
                    <div class="akd-card-id">
                        <t t-esc="order.order_name || ''"/>
                    </div>
                    <span class="akd-card-badge"><t t-esc="stateLabel(order.order_state || 'pending')"/></span>
                </div>
                <div class="akd-card-time">
                    <t t-esc="formatTime(order.order_date)"/>
                </div>
            </div>

            <div class="akd-card-meta">
                <span class="akd-card-meta-item">Table: <t t-esc="order.table_name || 'No Table'"/></span>
                <span class="akd-card-meta-item">Guest: <t t-esc="order.customer_name || 'Guest'"/></span>
            </div>

            <div class="akd-card-lines">
                <t t-foreach="order.lines || []" t-as="line" t-key="line.id">
                    <div t-attf-class="akd-card-line {{ line.item_state === 'done' ? 'akd-card-line--done' : '' }}">
                        <div>
                            <div class="akd-card-line-name">
                                <t t-esc="line.product_name || ''"/>
                            </div>
                            <t t-if="line.note">
                                <div class="akd-card-line-note">
                                    <t t-esc="line.note"/>
                                </div>
                            </t>
                        </div>
                        <div class="akd-card-line-qty">
                            x<t t-esc="line.quantity || 0"/>
                        </div>
                        <div class="akd-line-actions">
                            <t t-if="line.item_state === 'pending'">
                                <button class="akd-btn akd-btn--start" data-entity="line" data-action="start" t-att-data-id="line.id">Start</button>
                            </t>
                            <t t-elif="line.item_state === 'in_progress'">
                                <button class="akd-btn akd-btn--bump" data-entity="line" data-action="ready" t-att-data-id="line.id">Ready</button>
                            </t>
                            <t t-elif="line.item_state === 'ready'">
                                <button class="akd-btn akd-btn--serve" data-entity="line" data-action="done" t-att-data-id="line.id">Serve</button>
                            </t>
                            <t t-else="">
                                <button class="akd-btn akd-btn--ghost" data-entity="line" data-action="reset" t-att-data-id="line.id">Reset</button>
                            </t>
                            <t t-if="line.item_state !== 'done'">
                                <button class="akd-btn-cancel akd-btn-cancel--icon" data-entity="line" data-action="cancel" t-att-data-id="line.id" title="Cancel item">X</button>
                            </t>
                        </div>
                    </div>
                </t>
                <t t-if="!(order.lines &amp;&amp; order.lines.length)">
                    <div class="akd-card-line akd-card-line--done">
                        <div>
                            <div class="akd-card-line-name">No items</div>
                        </div>
                    </div>
                </t>
            </div>

            <div class="akd-card-actions akd-card-actions--order">
                <t t-if="order.order_state === 'pending'">
                    <button class="akd-btn akd-btn--start" data-entity="order" data-action="start" t-att-data-id="order.id">Start All</button>
                </t>
                <t t-elif="order.order_state === 'in_progress'">
                    <button class="akd-btn akd-btn--bump" data-entity="order" data-action="ready" t-att-data-id="order.id">Mark Ready</button>
                </t>
                <t t-elif="order.order_state === 'ready'">
                    <button class="akd-btn akd-btn--serve" data-entity="order" data-action="done" t-att-data-id="order.id">Complete</button>
                </t>
                <t t-else="">
                    <button class="akd-btn akd-btn--ghost" data-entity="order" data-action="start" t-att-data-id="order.id">Reopen</button>
                </t>
                <t t-if="order.order_state !== 'done'">
                    <button class="akd-btn akd-btn--danger" data-entity="order" data-action="cancel" t-att-data-id="order.id">Cancel Order</button>
                </t>
            </div>
        </div>
    </t>
</templates>

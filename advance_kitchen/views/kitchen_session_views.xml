<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advance_kitchen_session_list" model="ir.ui.view">
        <field name="name">kitchen.session.list</field>
        <field name="model">kitchen.session</field>
        <field name="arch" type="xml">
            <list default_order="start_at desc">
                <field name="name"/>
                <field name="kitchen_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="start_at" optional="hide"/>
                <field name="stop_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_advance_kitchen_session_form" model="ir.ui.view">
        <field name="name">kitchen.session.form</field>
        <field name="model">kitchen.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_display" type="object" string="Open Display" class="btn-primary" invisible="state != 'opened'"/>
                    <button name="action_close" type="object" string="Close" class="btn-secondary" invisible="state != 'opened'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="kitchen_id"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="start_at" readonly="1"/>
                        <field name="stop_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advance_kitchen_session" model="ir.actions.act_window">
        <field name="name">Kitchen Sessions</field>
        <field name="res_model">kitchen.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"create": False, "edit": False}</field>
    </record>

</odoo>

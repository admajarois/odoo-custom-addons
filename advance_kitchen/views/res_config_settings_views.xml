<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advance_kitchen</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="inside">
                <setting id="advance_kitechen" help="Select the kitchen for POS order." invisible="not pos_module_pos_restaurant" name="pos_kitchen_id" string="Kitchen">
                    <field name="pos_kitchen_id" widget="many2one" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

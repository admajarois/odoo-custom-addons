<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_kitchen_display.SendToKitchenButton"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="btn btn-primary send-to-kitchen"
                    t-on-click="() => this.sendToKitchen()">
                <i class="fa fa-utensils me-1"/>
                Send to Kitchen
            </button>
        </xpath>
    </t>

</templates>